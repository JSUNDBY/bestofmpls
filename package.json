{
  "name": "bestofmpls",
  "version": "0.1.0",
  "private": true,
  "description": "The Twin Cities, curated.",
  "scripts": {
    "scrape": "node scripts/scrape-events.js",
    "horoscope": "node scripts/build-horoscope.js",
    "rightnow": "node scripts/build-rightnow.js",
    "livingbest": "node scripts/livingbest.js",
    "geocode": "node scripts/geocode.js",
    "fetch-hours": "node scripts/fetch-hours.js",
    "build": "node scripts/build.js",
    "build:full": "node scripts/scrape-events.js && node scripts/build-horoscope.js && node scripts/build-rightnow.js && node scripts/livingbest.js && node scripts/build.js",
    "serve": "npx serve dist -p 47823",
    "dev": "node scripts/build.js && npx serve dist -p 47823",
    "shorts": "node scripts/build-shorts.js",
    "shorts:auth": "node scripts/upload-short.js --auth",
    "shorts:upload": "node scripts/upload-short.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "puppeteer-core": "^25.10.0"
  },
  "devDependencies": {
    "googleapis": "^173.0.0"
  }
}
